#!/bin/bash
set -euo pipefail; IFS=$'\n\t'

# Secrets come from SSM Parameter Store in production, through the instance
# role. Other runs pass them as plain env and leave SSM_SECRETS unset.
if [ -n "${SSM_SECRETS:-}" ]; then
  DB_USERNAME="$(/usr/local/bin/aws ssm get-parameter --name /mysql/users/mediawiki/username --query Parameter.Value --output text)"
  DB_PASSWORD="$(/usr/local/bin/aws ssm get-parameter --with-decryption --name /mysql/users/mediawiki/password --query Parameter.Value --output text)"
fi

echo "Use $DB_USERNAME user"

# The client options take the host and the port apart. DB_SERVER carries them
# together, the way MediaWiki writes $wgDBserver.
DB_SERVER="${DB_SERVER:-localhost}"
DB_HOST="${DB_SERVER%%:*}"
DB_PORT="${DB_SERVER##*:}"
if [ "$DB_PORT" = "$DB_SERVER" ]; then
  DB_PORT=3306
fi

cat <<EOF >/root/.my.cnf
[mysqldump]
protocol=TCP
host=$DB_HOST
port=$DB_PORT
user=$DB_USERNAME
password=$DB_PASSWORD
single-transaction
EOF

touch /tmp/log
crond
tail -f /tmp/log
